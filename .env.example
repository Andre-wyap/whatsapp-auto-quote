# Internal URL of Evolution API (no trailing slash needed).
EVOLUTION_API_URL=http://evolution-api:8080

# Evolution API key sent as the `apikey` header on every call.
# Recommended: use the auto-quote INSTANCE's own scoped token (returned as
# `hash` by POST /instance/create), not the global Evolution key — narrower
# blast radius if this service's env ever leaks.
EVOLUTION_API_KEY=

# Name of the Evolution instance this service sends through.
EVOLUTION_INSTANCE=auto-quote

# Shared secret n8n must send as `Authorization: Bearer <AUTO_QUOTE_TOKEN>`.
AUTO_QUOTE_TOKEN=

# Simple password gate for the dashboard (Phase 3).
DASHBOARD_PASSWORD=

# Port the HTTP server listens on.
PORT=3000
